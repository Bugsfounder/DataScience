   "source": [
    "from sklearn.cluster import AgglomerativeClustering \n",
    "import numpy as np \n",
    "x = np.array([[1,2],[1,4],[1,0],[4,2],[4,4],[4,0]])\n",
    "\n",
    "modelAgglo = AgglomerativeClustering()\n",
    "\n",
    "modelAgglo.fit(x)\n",
    "\n",
    "modelAgglo.children_\n",
    "modelAgglo.labels_\n",
    "modelAgglo.get_params\n"
   ]
  },
